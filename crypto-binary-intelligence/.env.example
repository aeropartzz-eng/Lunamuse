# =============================================================================
# Crypto & Binary Intelligence — .env.example
# =============================================================================
# COPIE este arquivo para `.env` e preencha os valores:
#   cp .env.example .env
#
# NUNCA commite o `.env` (ele está no .gitignore). NUNCA coloque chaves de
# API de exchange com permissão de saque — a especificação (§10) exige
# chaves SEM saque e com restrição de IP quando disponível.
#
# Todas as variáveis abaixo estão VAZIAS de propósito: este arquivo é só
# documentação do contrato de configuração. Valores de referência da
# especificação v4.1 estão nos comentários.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
# development | staging | production
ENVIRONMENT=
# Porta pública da API (dentro do container é sempre 8000)
API_PORT=

# --- PostgreSQL + TimescaleDB (Fase 2 — DB-001/DB-002) ----------------------
POSTGRES_DB=
POSTGRES_USER=
# OBRIGATÓRIA. Sem ela o serviço postgres-timescale não sobe.
POSTGRES_PASSWORD=

# --- Redis (Fase 2 — DB-003) -------------------------------------------------
# OBRIGATÓRIA. Senha do Redis (a especificação exige senha + limite de memória).
REDIS_PASSWORD=
# Limite de memória do Redis (orçamento inicial do documento: 250 MB)
REDIS_MAXMEMORY=

# --- NATS JetStream (Fase 2 — DB-004) ----------------------------------------
# URL interna usada pelos serviços (não precisa mudar no Docker Compose)
NATS_URL=

# --- API ---------------------------------------------------------------------
# URL de conexão montada pelo docker-compose a partir das variáveis acima.
DATABASE_URL=
# URL do Redis montada pelo docker-compose a partir das variáveis acima.
REDIS_URL=

# --- Modo de execução (TRAVA DE SEGURANÇA — §10) ----------------------------
# Valores possíveis: RESEARCH | BACKTEST | PAPER | TESTNET | LIVE
# O scaffold só aceita RESEARCH. O sistema NUNCA muda sozinho para LIVE:
# LIVE exige aprovação técnica, estatística, operacional e regulatória +
# autorização expressa do responsável (Fase 15, EXE-014).
EXECUTION_MODE=

# --- Grafana (§16) ------------------------------------------------------------
GRAFANA_ADMIN_USER=
# OBRIGATÓRIA. Sem ela o serviço grafana não sobe.
GRAFANA_ADMIN_PASSWORD=

# --- Telegram Bot (Fase 14 — SIG-004) -----------------------------------------
# Token do bot criado no @BotFather. Deixar vazio até a Fase 14.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Business Platform oficial (Fase 14 — SIG-005) ------------------
# Credenciais da Meta (developers.facebook.com/docs/whatsapp/).
# Deixar vazio até a Fase 14. Não usar automação por navegador.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Exchanges — PRIMEIRO GRUPO (Fases 4–5) ----------------------------------
# Chaves de API SOMENTE de leitura no início (sem saque, sem trade).
# Cada exchange só é ativada quando o conector correspondente estiver
# implementado e testado. Deixar vazio até lá.
# Binance: https://developers.binance.com/docs/binance-spot-api-docs
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Bybit: https://bybit-exchange.github.io/docs/v5/intro
BYBIT_API_KEY=
BYBIT_API_SECRET=
# OKX: https://www.okx.com/docs-v5/en/
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Coinbase Advanced: https://docs.cdp.coinbase.com/advanced-trade/docs/welcome
COINBASE_API_KEY=
COINBASE_API_SECRET=
# Kraken: https://docs.kraken.com/api/
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Bitget: https://www.bitget.com/api-doc/common/intro
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
# Gate.io: https://www.gate.com/docs/developers/apiv4/en/
GATEIO_API_KEY=
GATEIO_API_SECRET=

# --- DEX / On-chain (Fase 6) -------------------------------------------------
# DEX Screener: https://docs.dexscreener.com/api/reference (sem chave p/ leitura pública)
# PancakeSwap / Raydium / Uniswap / Jupiter: ver docs/ em cada conector.
# RPCs de BNB Chain, Solana, Ethereum e Base.
BSC_RPC_URL=
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
# Provedores on-chain opcionais (Fase 6 — SEC-006)
HELIUS_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=

# --- Crypto Shield — antifraude (Fase 6, §7) ---------------------------------
# GoPlus: https://docs.gopluslabs.io/ | RugCheck: https://rugcheck.xyz/
# Bubblemaps: https://bubblemaps.io/
# Sem chave nestes arquivos: configurar apenas quando o serviço existir.
RUGCHECK_API_KEY=
BUBBLEMAPS_API_KEY=

# --- TradingView webhook (fonte complementar, §9) ----------------------------
# Token secreto do webhook HTTPS. Deixar vazio até a Fase 14.
TRADINGVIEW_WEBHOOK_SECRET=

# --- Object Storage / backup (Fase 1 — INF-008) ------------------------------
# Estimativa do documento: ~US$ 3/mês por 100 GB. Confirmar antes de contratar.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Região do Object Storage (default do backup.sh: us-east-1)
S3_REGION=
# Prefixo dos objetos de backup dentro do bucket (default: postgres).
# Use um bucket (ou prefixo) DIFERENTE por ambiente (ver
# infrastructure/deployment/environments.md).
BACKUP_PREFIX=
# Diretório local dos dumps (default: ./data/backups)
BACKUP_DIR=
# Retenção: dias de dumps locais (default: 7) e remotos (default: 30)
BACKUP_RETENTION_DAYS=
BACKUP_REMOTE_RETENTION_DAYS=

# --- Infraestrutura / VPS (Fase 1 — INF-002 a INF-004) -----------------------
# Timezone do servidor (default dos scripts: America/Fortaleza)
TIMEZONE=
# Porta SSH endurecida (default: 22). Deve ser a mesma em harden-ssh.sh e
# firewall.sh.
SSH_PORT=
# Domínio base do painel (ex.: cbi.exemplo.com). O Caddy serve o painel em
# https://<DOMAIN> e a API em https://api.<DOMAIN>. Ver
# infrastructure/caddy/README.md — DNS pendente.
DOMAIN=
# E-mail para avisos do Let's Encrypt (renovação/expiração do TLS)
ACME_EMAIL=

# --- Observabilidade (§16) ----------------------------------------------------
# URLs internas (não precisam mudar no Docker Compose)
PROMETHEUS_URL=
GRAFANA_URL=
